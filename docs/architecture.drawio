        <UserObject label="Seekers and advertisers&lt;br&gt;&lt;span style=&quot;color:#5B6577&quot;&gt;browser or phone&lt;/span&gt;" tooltip="People using TraceHome in a browser or the phone app. Every request starts here." id="users">
