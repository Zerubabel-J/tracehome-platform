          <mxGeometry height="100" width="400" x="15" y="30" as="geometry" />
        </mxCell>
        <UserObject label="NAT gateway" tooltip="Outbound only, for zone B. One NAT per zone, so a zone failure never cuts the other zone off." id="natb">
          <mxCell parent="pubb" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;labelBackgroundColor=default;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;" vertex="1">
