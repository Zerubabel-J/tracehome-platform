        <mxCell id="datab" parent="azb" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=30;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;dashed=0;fontStyle=0;fontSize=11;" value="Private data subnet · 10.20.21.0/24" vertex="1">
          <mxGeometry height="165" width="400" x="15" y="345" as="geometry" />
        </mxCell>
        <UserObject label="RDS standby&lt;br&gt;(Multi-AZ)" tooltip="Synchronous copy of the primary. Serves nothing until it takes over automatically; failover duration varies." id="rdsb">
          <mxCell parent="datab" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;labelBackgroundColor=default;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1">
            <mxGeometry height="48" width="48" x="45" y="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Load balancer&lt;br&gt;(internal)" tooltip="Application Load Balancer with nodes in both app subnets. No public address: reached only through the CloudFront VPC origin. SG: allows CloudFront only." id="alb">
          <mxCell parent="vpc" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;labelBackgroundColor=default;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;" vertex="1">
