        <mxCell id="jb_cap" parent="jb" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3B4C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" value="&lt;div style=&quot;font-size:15px;font-weight:bold;color:#2F3B4C;margin-bottom:6px&quot;&gt;Browsing&lt;/div&gt;&lt;table style=&quot;font-size:12px;color:#232F3E&quot;&gt;&lt;tr&gt;&lt;td style=&quot;color:#2F3B4C;font-weight:bold;padding-right:8px;vertical-align:top&quot;&gt;B1&lt;/td&gt;&lt;td&gt;Route 53 answers with the nearest CloudFront edge&#39;s address&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#2F3B4C;font-weight:bold;padding-right:8px;vertical-align:top&quot;&gt;B2&lt;/td&gt;&lt;td&gt;HTTPS to CloudFront; WAF checks the request. Website files come from the cache or the web bucket&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#2F3B4C;font-weight:bold;padding-right:8px;vertical-align:top&quot;&gt;B3&lt;/td&gt;&lt;td&gt;/photos/*: from the cache, or from the photos bucket through OAC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#2F3B4C;font-weight:bold;padding-right:8px;vertical-align:top&quot;&gt;B4&lt;/td&gt;&lt;td&gt;/api/*: through the private VPC origin to the internal load balancer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#2F3B4C;font-weight:bold;padding-right:8px;vertical-align:top&quot;&gt;B5&lt;/td&gt;&lt;td&gt;Load balancer → API in either zone → search in PostgreSQL; the response returns the same way&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="145" width="1580" x="20" y="1465" as="geometry" />
        </mxCell>
