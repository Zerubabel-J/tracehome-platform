        <UserObject label="Route 53" tooltip="DNS. An alias record answers with the address of the nearest CloudFront edge. It only answers the lookup; it carries no traffic." id="r53">
          <mxCell parent="infra" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;labelBackgroundColor=default;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1">
            <mxGeometry height="48" width="48" x="560" y="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="AWS WAF" tooltip="Web firewall attached to CloudFront: managed rules and rate limits block attacks before they reach anything." id="waf">
          <mxCell parent="infra" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;labelBackgroundColor=default;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1">
            <mxGeometry height="48" width="48" x="700" y="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="CloudFront" tooltip="CDN and front door. HTTPS with an ACM certificate (us-east-1), Shield Standard. Picks the origin by path: /api/* → VPC origin → ALB, /photos/* → photos bucket, everything else → web bucket. Caches public content (pages at most 60 s); never caches personal data." id="cf">
          <mxCell parent="infra" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;labelBackgroundColor=default;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1">
            <mxGeometry height="48" width="48" x="820" y="185" as="geometry" />
          </mxCell>
        </UserObject>
