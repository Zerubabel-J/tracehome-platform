        <mxCell id="jp_P8" parent="jp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" value="P8" vertex="1">
