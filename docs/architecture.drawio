          <mxGeometry height="185" width="400" x="15" y="145" as="geometry" />
        </mxCell>
        <UserObject label="API&lt;br&gt;(ECS Fargate)" tooltip="API service task in zone B. Both zones serve requests at the same time (active-active)." id="apib">
