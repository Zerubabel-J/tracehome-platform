          <mxGeometry height="185" width="400" x="15" y="145" as="geometry" />
        </mxCell>
        <UserObject label="Workers&lt;br&gt;(ECS Fargate)" tooltip="Worker service task in zone A. Same image as the API, different command. Pulls the upload results queue and runs scheduled jobs. SG: no inbound traffic." id="wa">
