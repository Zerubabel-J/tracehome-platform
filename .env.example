# Copy to .env only if you want values other than the local defaults in docker-compose.yml.
# .env is ignored by git. Never put real passwords, keys, or account IDs in this file.

# Local PostgreSQL password (the local container only).
POSTGRES_PASSWORD=replace-with-a-local-password

# Signs demo sign-in tokens (decision 82). On AWS this comes from Secrets Manager.
TOKEN_SIGNING_KEY=replace-with-a-long-random-string
