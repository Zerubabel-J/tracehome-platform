{
  "family": "tracehome-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/tracehome-dev-ecs-execution",
  "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/tracehome-dev-api-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "${IMAGE_URI}",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "APP_ENV", "value": "aws-dev" },
        { "name": "AWS_REGION", "value": "${AWS_REGION}" },
        { "name": "DB_HOST", "value": "${DB_HOST}" },
        { "name": "DB_NAME", "value": "tracehome" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "DB_POOL_SIZE", "value": "5" },
        { "name": "INCOMING_BUCKET", "value": "${INCOMING_BUCKET}" },
        { "name": "PHOTOS_BUCKET", "value": "${PHOTOS_BUCKET}" },
        { "name": "UPLOAD_RESULTS_QUEUE_NAME", "value": "${UPLOAD_RESULTS_QUEUE}" },
        { "name": "DEMO_SIGN_IN_ENABLED", "value": "true" },
        { "name": "FORWARDED_ALLOW_IPS", "value": "*" }
      ],
      "secrets": [
        { "name": "DB_USER", "valueFrom": "${DB_SECRET_ARN}:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "${DB_SECRET_ARN}:password::" },
        { "name": "TOKEN_SIGNING_KEY", "valueFrom": "${TOKEN_SECRET_ARN}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tracehome-dev",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "api"
        }
      },
      "linuxParameters": { "initProcessEnabled": true },
      "stopTimeout": 30
    }
  ]
}
