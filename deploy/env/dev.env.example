# Copy to deploy/env/dev.env and fill in. dev.env is ignored by git: it holds the account ID
# and resource ARNs, which must never be in this public repository.

# Every laptop command uses this named profile. The laptop's default profile is another account.
AWS_PROFILE_NAME=tracehome
AWS_REGION=us-east-1
# The scripts stop if the profile points to any other account (12 digits).
EXPECTED_ACCOUNT_ID=

ECR_REPOSITORY=tracehome
CLUSTER=tracehome-dev

# RDS endpoint address, and the secret RDS created for its master user
# (Secrets Manager -> the secret named rds!db-...; copy its full ARN)
DB_HOST=
DB_SECRET_ARN=
# A secret you create once with a long random value (see docs/deploy-ecs.md, step 3)
TOKEN_SECRET_ARN=

INCOMING_BUCKET=
PHOTOS_BUCKET=
WEB_BUCKET=
UPLOAD_RESULTS_QUEUE=upload-results

# Private app subnets (both zones) and the security group the tasks use
APP_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
APP_SECURITY_GROUP=sg-xxxxxxxx

# Filled in after CloudFront exists (phase 6)
CLOUDFRONT_DOMAIN=
DISTRIBUTION_ID=
