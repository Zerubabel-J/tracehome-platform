{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SignPresignedUploadsIntoUploadsPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${INCOMING_BUCKET}/uploads/*"
    },
    {
      "Sid": "EcsExecSessions",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    }
  ]
}
